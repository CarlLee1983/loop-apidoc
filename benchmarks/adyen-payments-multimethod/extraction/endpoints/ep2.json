  "method": "POST",
  "path": "/paymentMethods",
  "source": "CheckoutService-v71.json paths./paymentMethods.post (operationId post-paymentMethods)",
  "parameters": [
    {
      "name": "merchantAccount",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "The merchant account identifier, with which you want to process the transaction."
    },
    {
      "name": "amount",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "Amount used to filter the available payment methods."
    },
    {
      "name": "countryCode",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "The shopper's country code."
    },
    {
      "name": "channel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "The platform where a payment transaction takes place. This field can be used for filtering out payment methods that are only available on specific platforms. Possible values: * iOS * Android * Web"
