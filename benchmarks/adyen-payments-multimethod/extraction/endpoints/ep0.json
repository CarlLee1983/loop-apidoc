{
  "method": "POST",
  "path": "/payments",
  "source": "CheckoutService-v71.json paths./payments.post (operationId post-payments)",
  "parameters": [
    {
      "name": "amount",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "Transaction amount (Amount: currency + value in minor units)."
    },
    {
      "name": "merchantAccount",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "The merchant account identifier, with which you want to process the transaction."
    },
    {
      "name": "reference",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "The reference to uniquely identify a payment. This reference is used in all communication with you about the payment status. To provide multiple references for one transaction, separate the reference values with the hyphen (`-`) characte..."
    },
    {
      "name": "returnUrl",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "The URL to return to in case of a redirection. The format depends on the channel. * For web, include the protocol `http://` or `https://`. You can also include your own additional query parameters, for example, shopper ID or order refere..."
    },
    {
      "name": "paymentMethod",
      "in": "body",
      "type": "object",
      "required": true,
      "one_of": [
        "CardDetails",
        "IdealDetails",
        "ApplePayDetails"
      ],
      "discriminator": {
        "property_name": "type",
        "mapping": {
          "scheme": "CardDetails",
          "ideal": "IdealDetails",
          "applepay": "ApplePayDetails"
        }
      },
      "description": "The type and required details of a payment method to use, selected by the `type` discriminator. The full spec lists 40+ members; this benchmark captures three representative ones (CardDetails / IdealDetails / ApplePayDetails)."
    }
  ],
  "request": {
    "content_type": "application/json",
    "schema": "PaymentRequest",
    "required": true,
    "description": "PaymentRequest: amount + merchantAccount + reference + returnUrl + paymentMethod (oneOf union, see CardDetails/IdealDetails/ApplePayDetails).",
    "schema_ref": "PaymentRequest"
  },
  "responses": [
    {
      "status": "200",
      "description": "OK - the request has succeeded.",
      "schema": null,
      "schema_ref": "PaymentResponse"
    },
    {
      "status": "400",
      "description": "Bad Request - a problem reading or understanding the request.",
      "schema": null,
      "schema_ref": "ServiceError"
    },
    {
      "status": "401",
      "description": "Unauthorized - authentication required.",
      "schema": null,
      "schema_ref": "ServiceError"
    },
    {
      "status": "403",
      "description": "Forbidden - insufficient permissions to process the request.",
      "schema": null,
      "schema_ref": "ServiceError"
    },
    {
      "status": "422",
      "description": "Unprocessable Entity - a request validation error.",
      "schema": null,
      "schema_ref": "ServiceError"
    },
    {
      "status": "500",
      "description": "Internal Server Error - the server could not process the request.",
      "schema": null,
      "schema_ref": "ServiceError"
    }
  ],
  "tags": [
    "Payments"
  ],
  "security": [
    "ApiKeyAuth",
    "BasicAuth"
  ],
  "examples": [],
